<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.omnipay.sdk">

    <!-- Permissions required for network authorization & contactless payments -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:label="@string/app_name"
        android:supportsRtl="true">

        <activity
            android:name=".ui.OmniPayCheckoutActivity"
            android:label="@string/checkout_title"
            android:theme="@style/Theme.OmniPay.Checkout"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="com.omnipay.sdk.ACTION_CHECKOUT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>

</manifest>
